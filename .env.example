# Choose ONE provider.

# 1) Free, local, no key (install Ollama, then: ollama pull qwen3:8b)
#    8 GB GPU: qwen3:8b or qwen2.5:7b. 27B models (qwen3.8) need ~20 GB of GPU memory.
# GREENTAG_PROVIDER=ollama
# GREENTAG_MODEL=qwen3:8b
# GREENTAG_THINK=0

# 2) Claude API
GREENTAG_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# 3) OpenAI
# GREENTAG_PROVIDER=openai
# OPENAI_API_KEY=
